{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ydah/ibex/main/schema/generation-manifest-v1.schema.json",
  "title": "Ibex generation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ibex_manifest",
    "schema_version",
    "input",
    "options",
    "artifacts"
  ],
  "properties": {
    "ibex_manifest": {
      "const": "generation"
    },
    "schema_version": {
      "const": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "sha256",
        "files"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "options": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytesize"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytesize": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256",
        "bytesize"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytesize": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
