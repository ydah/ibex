{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ydah/ibex/main/schema/cst-v1.json",
  "title": "Ibex concrete syntax tree v1",
  "type": "object",
  "required": [
    "ibex_ir",
    "schema_version",
    "grammar_digest",
    "table_format",
    "state_count",
    "production_count",
    "trivia_policy",
    "kinds",
    "root",
    "memo"
  ],
  "properties": {
    "ibex_ir": { "const": "cst" },
    "schema_version": { "const": 1 },
    "grammar_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "table_format": { "type": "integer", "minimum": 1 },
    "state_count": { "type": "integer", "minimum": 0 },
    "production_count": { "type": "integer", "minimum": 0 },
    "trivia_policy": {
      "enum": ["leading", "balanced", "drop"]
    },
    "kinds": { "$ref": "#/$defs/kinds" },
    "root": { "$ref": "#/$defs/node" },
    "memo": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/memo" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "integerPair": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "integerMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "kindMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "kinds": {
      "type": "object",
      "required": [
        "names",
        "terminal_range",
        "nonterminal_range",
        "named",
        "named_nonterminals",
        "trivia",
        "synthetic"
      ],
      "properties": {
        "names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "terminal_range": { "$ref": "#/$defs/integerPair" },
        "nonterminal_range": { "$ref": "#/$defs/integerPair" },
        "named": { "$ref": "#/$defs/kindMap" },
        "named_nonterminals": { "$ref": "#/$defs/integerMap" },
        "trivia": { "$ref": "#/$defs/kindMap" },
        "synthetic": { "$ref": "#/$defs/kindMap" }
      },
      "additionalProperties": false
    },
    "encodedBytes": {
      "type": "object",
      "required": ["b64"],
      "properties": {
        "b64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/encodedBytes" }
      ]
    },
    "trivia": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "$ref": "#/$defs/text" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "token": {
      "type": "object",
      "required": ["k", "f", "e", "t", "l", "r"],
      "properties": {
        "k": { "type": "integer", "minimum": 0 },
        "f": { "type": "integer", "minimum": 0, "maximum": 63 },
        "e": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "t": { "$ref": "#/$defs/text" },
        "l": {
          "type": "array",
          "items": { "$ref": "#/$defs/trivia" }
        },
        "r": {
          "type": "array",
          "items": { "$ref": "#/$defs/trivia" }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["k", "f", "c"],
      "properties": {
        "k": { "type": "integer", "minimum": 0 },
        "f": { "type": "integer", "minimum": 0, "maximum": 63 },
        "c": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        }
      },
      "additionalProperties": false
    },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/node" },
        { "$ref": "#/$defs/token" }
      ]
    },
    "memo": {
      "type": "object",
      "required": ["version", "left_states"],
      "properties": {
        "version": { "const": 1 },
        "left_states": {
          "type": "array",
          "items": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    }
  }
}
