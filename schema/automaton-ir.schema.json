{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ydah/ibex/main/schema/automaton-ir.schema.json",
  "title": "Ibex current Automaton IR",
  "description": "A self-contained parser automaton embedding the current Grammar IR and its parser contract.",
  "type": "object",
  "required": [
    "ibex_ir",
    "schema_version",
    "algorithm",
    "entry_construction",
    "grammar_digest",
    "grammar",
    "states",
    "conflict_summary"
  ],
  "properties": {
    "ibex_ir": {
      "const": "automaton"
    },
    "schema_version": {
      "const": 1
    },
    "algorithm": {
      "enum": [
        "slr",
        "lalr1",
        "ielr1",
        "lr1"
      ]
    },
    "entry_construction": {
      "enum": [
        "shared",
        "isolated"
      ]
    },
    "grammar_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "grammar": {
      "$ref": "grammar-ir.schema.json"
    },
    "entry_states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "automaton-ir-definitions.schema.json#/$defs/state"
      }
    },
    "conflict_summary": {
      "$ref": "automaton-ir-definitions.schema.json#/$defs/conflict_summary"
    }
  },
  "additionalProperties": false
}
