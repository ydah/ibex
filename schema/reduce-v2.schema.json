{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ydah/ibex/main/schema/reduce-v2.schema.json",
  "title": "Ibex reduce report v2",
  "type": "object",
  "required": [
    "ibex_report", "schema_version", "result", "mode", "bounded", "bounds"
  ],
  "properties": {
    "ibex_report": { "const": "reduce" },
    "schema_version": { "const": 2 },
    "result": { "enum": ["minimized", "incomplete", "budget_exhausted"] },
    "mode": { "enum": ["tokens", "lines", "bytes"] },
    "original_size": { "type": "integer", "minimum": 0 },
    "minimized_size": { "type": "integer", "minimum": 0 },
    "trials": { "type": "integer", "minimum": 1 },
    "complete": { "type": "boolean" },
    "minimized": { "type": "array" },
    "bounded": { "const": true },
    "bounds": {
      "type": "object",
      "required": [
        "max_trials", "timeout_seconds", "max_output_bytes", "max_input_bytes"
      ],
      "properties": {
        "max_trials": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_input_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["kind", "message", "trials"],
      "properties": {
        "kind": {
          "enum": ["input_bytes", "subprocess_timeout", "subprocess_output"]
        },
        "message": { "type": "string", "minLength": 1 },
        "trials": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "result": { "enum": ["minimized", "incomplete"] } }
      },
      "then": {
        "required": [
          "original_size", "minimized_size", "trials", "complete", "minimized"
        ]
      }
    },
    {
      "if": { "properties": { "result": { "const": "budget_exhausted" } } },
      "then": { "required": ["budget"] }
    }
  ],
  "additionalProperties": false
}
